		<drop event="Harvest" name="plantedPotato1" count="1" prob="0.25" tag="farmerBonusSeed"/>
	</append>

	<append xpath="/blocks/block[@name='plantedChrysanthemum3HarvestPlayer']">
		<property name="DowngradeBlock" value="plantedChrysanthemum1Regrow"/>
		<drop event="Harvest" name="plantedChrysanthemum1" count="1" prob="0.25" tag="farmerBonusSeed"/>
	</append>

	<append xpath="/blocks/block[@name='plantedCorn3HarvestPlayer']">
		<property name="DowngradeBlock" value="plantedCorn1Regrow"/>
		<drop event="Harvest" name="plantedCorn1" count="1" prob="0.25" tag="farmerBonusSeed"/>
	</append>

	<append xpath="/blocks/block[@name='plantedGraceCorn3HarvestPlayer']">
