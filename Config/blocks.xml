		<drop event="Harvest" name="plantedCotton1" count="1" prob="0.25" tag="farmerBonusSeed"/>
	</append>

	<append xpath="/blocks/block[@name='plantedCoffee3HarvestPlayer']">
		<property name="DowngradeBlock" value="plantedCoffee1Regrow"/>
		<drop event="Harvest" name="plantedCoffee1" count="1" prob="0.25" tag="farmerBonusSeed"/>
