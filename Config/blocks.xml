<configs>

	<!-- Strip vanilla's full-rate seed drops FIRST (before the reduced-chance
	     ones are appended below): the always-on farmerBonusSeed harvest drop
	     and the on-destroy seed drop. Order matters ~ 7DTD applies patches top
	     to bottom, so this must precede the appends or it would also remove the
	     new drops (they share the farmerBonusSeed tag). -->
	<remove xpath="/blocks/block[contains(@name, 'HarvestPlayer')]/drop[contains(@event, 'Destroy') or contains(@tag, 'farmerBonusSeed')]" />

	<!-- Each harvested plant reverts to its growing (stage 1) block via
	     DowngradeBlock (TFP ships this hook commented-out per crop; we enable
	     it), PLUS a reduced-chance bonus seed on harvest (was 100% with the
	     Living off the Land perk; now prob 0.25). Bump the prob values to taste. -->

	<append xpath="/blocks/block[@name='plantedMushroom3HarvestPlayer']">
		<property name="DowngradeBlock" value="plantedMushroom1"/>
		<drop event="Harvest" name="plantedMushroom1" count="1" prob="0.25" tag="farmerBonusSeed"/>
	</append>

	<append xpath="/blocks/block[@name='plantedYucca3HarvestPlayer']">
		<property name="DowngradeBlock" value="plantedYucca1"/>
